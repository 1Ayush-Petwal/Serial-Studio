# Copy to .env (git-ignored) and fill in. Never commit .env.

# Postgres: docker-compose locally, Supabase session pooler (port 5432) when hosted.
DATABASE_URL=postgresql://serial:serial@localhost:54329/serial

# Model providers
GROQ_API_KEY=
GEMINI_API_KEY=

# Role overrides (optional; defaults in src/serial_studio/models.toml [roles])
# JUDGE_MODEL=groq:openai/gpt-oss-120b
# WRITER_MODEL=gemini:gemini-2.5-flash

# Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
